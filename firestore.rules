rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read and write for global settings
    match /settings/{settingsId} {
      allow read, write: if true;
    }

    // Allow read and write for doctor profiles
    match /doctors/{doctorId} {
      allow read, write: if true;
    }

    // Allow read and write for case studies
    match /caseStudies/{caseId} {
      allow read, write: if true;
    }

    // Allow read and write for patient testimonials
    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }

    // Allow read and write for clinic gallery items
    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    // Allow read and write for appointment bookings
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Allow read and write for generated leads and contacts
    match /leads/{leadId} {
      allow read, write: if true;
    }
  }
}
